    function initiateVacationOffer(dateStr) {
        let userKey = currentUser.firstName + "_" + currentUser.lastName;
        let targetWeek = getWeekKey(dateStr);
        let userName = currentUser.firstName;

        let freedSlots = 1;
        let offerId = userKey + "_" + dateStr;

        // Create a deterministic queue of users who are NOT the one going on vacation
        let queue = Object.keys(globalUsersData).filter(k => k !== userKey).sort();

        db.ref(`vacation_offers/${targetWeek}/${offerId}`).once('value').then(snap => {
            if (!snap.exists()) {
                db.ref(`vacation_offers/${targetWeek}/${offerId}`).set({
                    vacationUser: userKey,
                    vacationUserName: userName,
                    date: dateStr,
                    slots: freedSlots,
                    timestamp: Date.now(),
                    queue: queue,
                    currentQueueIndex: 0,
                    status: 'open'
                });
                showToast("Отпуск отмечен. Коллегам предложены доп. смены.");
            }
        });
    }

    function listenForVacationOffers() {
        let userKey = currentUser.firstName + "_" + currentUser.lastName;

        db.ref('vacation_offers').on('value', snap => {
            let offersByWeek = snap.val();
            if (!offersByWeek) return;

            // We use a flag to only show one modal at a time.
            if (document.getElementById('vacationOfferModal') && document.getElementById('vacationOfferModal').style.display === 'flex') return;

            for (let weekKey in offersByWeek) {
                let offers = offersByWeek[weekKey];
                for (let offerId in offers) {
                    let offer = offers[offerId];

                    // Only process open offers
                    if (offer.status !== 'open') continue;
                    // Ignore old offers (older than 24 hours) to prevent ancient spam
                    if (Date.now() - offer.timestamp > 86400000) continue;

                    // Sequential logic: Is it my turn?
                    if (offer.queue && offer.queue.length > 0 && offer.currentQueueIndex < offer.queue.length) {
                        if (offer.queue[offer.currentQueueIndex] === userKey) {
                            showOfferPopup(weekKey, offerId, offer);
                            return; // Only show one popup at a time
                        }
                    } else if (offer.queue && offer.currentQueueIndex >= offer.queue.length) {
                        // Queue exhausted, close offer
                        db.ref(`vacation_offers/${weekKey}/${offerId}/status`).set('exhausted');
                    }
                }
            }
        });
    }

